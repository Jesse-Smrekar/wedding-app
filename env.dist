JWT_SECRET= # Either generate a new one or copy the one from an existing project location
HTTP_PORT=8080
HTTPS_PORT=8443

SPOTIFY_CLIENT_ID= # Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_SECRET= # Get from https://developer.spotify.com/dashboard
SPOTIFY_AUTH_REDIRECT_URL= # either local or the production domain + /spotify/auth/redirect

DATABASE_URL=postgresql://localhost
PGUSER=postgres
PGPASSWORD=password

# No Spotify token env var is needed. The user-scoped token is stored in the DB
# after an admin visits /admin/spotify/login once; it is shared across all
# instances and survives restarts.
